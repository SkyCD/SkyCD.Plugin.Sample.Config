<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="SkyCD.SDK" Version="[$(SkyCdSdkVersion)]" PrivateAssets="all"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.0.0</Version>
        <RepositoryUrl>https://github.com/SkyCD/SkyCD.Plugin.Sample.Config</RepositoryUrl>
        <PackageProjectUrl>https://github.com/SkyCD/SkyCD.Plugin.Sample.Config</PackageProjectUrl>
        <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Company>SkyCD</Company>
        <Authors>SkyCD</Authors>
        <AssemblyTitle>Sample Configuration</AssemblyTitle>
        <Description>Demonstrates an embedded, session-local Options draft page without a UI dependency.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
    </ItemGroup>
    <ItemGroup>
        <AssemblyMetadata Include="AuthorUrl" Value="https://sourceforge.net/projects/skycd/"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="../../LICENSE;../../README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
